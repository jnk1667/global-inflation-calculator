  "_meta": {
    "description": "Annual average spending benchmarks per pet category for dogs and cats across 8 currencies. Used by the Pet Inflation Calculator to pre-populate cost inputs and calculate projected spend. Sourced from national pet industry associations, government surveys, and major insurance providers. All values are in local currency.",
    "note": "Benchmarks represent median/average annual spend for a single adult dog or cat in a typical urban household. They are not inflation indices — they are real-world cost anchors derived from consumer surveys and insurance claim data. Use these as default calculator inputs, not as CPI replacements.",
    "categories": {
      "food": "Annual cost of commercially-prepared pet food (dry + wet, typical quality)",
      "vet": "Annual veterinary costs (routine checkup + vaccinations + one minor illness visit, no major surgery)",
      "insurance": "Annual pet insurance premium (mid-tier accident & illness coverage)",
      "grooming": "Annual professional grooming costs (breed-average frequency)",
      "supplies": "Annual supplies, toys, treats, bedding, accessories (excluding one-time setup)"
    },
    "lastUpdated": "2026-05-25"
  },
